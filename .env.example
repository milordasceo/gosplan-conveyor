# .env.example — только имена; значения вписывай локально, файл в репозиторий не коммитить

# 1) gosplan.info (агрегатор закупок). Тест-сервер v2test.gosplan.info работает без ключа.
#    Прод v2.gosplan.info: ключ получают через Telegram t.me/gosplan_project (trial 7 дней).
#    Куда: scripts/config.yaml поле api_key (или сюда — gosplan_lib читает среду).
GOSPLAN_API_KEY=

# 2) Notion (CRM «Реестр тендеров»). OAuth по инструкции фреймворка (в OpenBot —
#    Server settings > MCP > Notion) или internal integration токен с доступом к базе.
#    Куда: настройки Notion-коннектора агента Просчёт/Смотритель.
NOTION_API_TOKEN=

# 3) Google Drive — хранилище файлов проекта. Через Composio: аккаунт Composio (Sign in
#    with Google) → подключить toolkit googledrive с ПОЛНЫМИ разрешениями; в вызовах
#    указывать account=<имя подключения, совпадает с ACCOUNT_ID>. Альтернатива: прямой
#    Drive-плагин с OAuth.
COMPOSIO_ACCOUNT=          # например googledrive_maru-breck
GOOGLE_OAUTH_CLIENT_ID=    # если коннектор требует свой OAuth-клиент
GOOGLE_OAUTH_CLIENT_SECRET=

# 4) Корневая папка Drive под карточки: создаётся один раз вручную или плагином.
#    В текущем исполнении id = 1O5sSu5w6gmB5_9VvOHzBYhwSo6lLJi8T (не секрет).
DRIVE_ROOT_ID=

# 5) Пути на машиные (по умолчанию как в OpenBot-набор):
TENDERS_DIR=Shared/tools/gosplan-scanner/tenders

# 6) zakupki.gov.ru: требует CA «Russian Trusted Root CA» в хранилище системы. Где взять
#    дистрибутив CA — не описано (см. WALKTHROUGH пробелы), установить локально.
CA_BUNDLE_PATH=

# Никогда не комментить: пароли адреса браузера, cookie Cookie.getSession (внутр), пользовательские токен-gалочки.
